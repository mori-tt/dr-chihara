# GitHub Pagesは全ページ確認用。検索には出さない（noindex固定・架空サンプル対談つき）。
DEPLOY_TARGET=github-pages
NEXT_PUBLIC_SITE_URL=https://mori-tt.github.io/dr-chihara
NEXT_PUBLIC_BASE_PATH=/dr-chihara
NEXT_PUBLIC_NOINDEX=1

# 本番ドメイン確定後は、テスト環境のcanonicalを本番へ向ける（LOLIPOP_SITE_URLと同じ値）。
# NEXT_PUBLIC_CANONICAL_URL=https://example.jp
